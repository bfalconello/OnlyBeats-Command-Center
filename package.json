{
  "name": "onlybeats-command-center",
  "version": "6.0.3",
  "description": "OnlyBeats automatic updater end-to-end verification release",
  "main": "desktop/main.js",
  "author": {
    "name": "OnlyBeats"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist": "electron-builder",
    "desktop:build": "npm run dist:win",
    "serve:mobile": "npx http-server app -p 8080 -c-1",
    "release:win": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.onlybeats.commandcenter",
    "productName": "OnlyBeats",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OnlyBeats-Setup-${version}.${ext}",
      "icon": "build/icon.ico",
      "publish": [
        {
          "provider": "github",
          "owner": "bfalconello",
          "repo": "OnlyBeats-Command-Center",
          "releaseType": "release",
          "publishAutoUpdate": true
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OnlyBeats",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "menuCategory": true,
      "perMachine": false,
      "displayLanguageSelector": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bfalconello",
        "repo": "OnlyBeats-Command-Center",
        "releaseType": "release",
        "publishAutoUpdate": true
      }
    ],
    "copyright": "Copyright \u00a9 2026 OnlyBeats"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}